{
  "user": "pixel_heart",
  "messages": [
    {
      "from": "me",
      "type": "text",
      "text": "Привіт, йдеш в гру?",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Привіт, я вже там.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Ок",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Хай. Йдеш грати?",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Через годину буду.",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Ок.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Привіт, будемо грати?",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Іншим разом, сьогодні зайнята.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Привіт, а тепер вільна?",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Хай. Я вже в грі.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Ок, я йду.",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Хай, чекаю на тебе у грі, маю подарунчик",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Йооой! Я про цю маску дуже довго мріяла. ДЯКУЮ ДЯКУЮ ДЯКУЮЮЮ!!!!",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Супер! Рада що сподобалось.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Привіт, граємо сьогодні?",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Хай. Зайнята.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Привіт, ти вільна?",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Я вже в грі цілу годину чекаю тебе",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Біжу!",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Хай, ну що там?",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Привіт, нові коди. Ти їх вже використала? ХХХХХХХХХ, ХХХХХХ, ХХХ та ХХХХХХ",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Не бачила, дякую. Нагороди могли бути й кращі. Щось вони лінуються нормальні речі давати.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Так. Мені також не дуже сподобалося що звичайні монети дали. Їх й так легко нафармити.",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Хай, йдеш у гру?",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Привіт, зайнята трішки. Буду пізніше.",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Ок",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Привіт! Грати будеш?",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Хай, ні. У мене трапилося дещо дивовижне.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "В сенсі? Що сталося?",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Мені дуже подобався один хлопачок. Він сьогодні запропонував мені замутити. Між нами тепер стусни.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Окей, супер. А чому грати не хочеш?",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Бо тепер я матиму менше часу на ігри.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Привіт, будеш грати?",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Хай. Ні.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "А коли будеш?",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Не знаю.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Привіт. Вже 7 місяців пройшло з часу нашої останньої спільної гри. Грати будеш?",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Хай, ні Я вже видалила гру.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Стоп... шо? Навіщо??",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Подорослішала. Реальне життя значно цікавіше. І ти якось спробуй.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "До чого тут гра? До реального життя.",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Ну ти спробуй.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Привіт. Вже роки 2 пройшло. Грати будеш?",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Ні. Я вже доросла для цього, шлюбна.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Тобі заважає статус шлюбної грати в ігри чи що?",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "У мене вже інший етап життя.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "А ігри?",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Вже є кому грати.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Нда...",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Привіт. Років 5 пройшло. Я знову завантажила гру. Будеш грати? Якщо це ще актуально для тебе.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Навіщо? Це гра не для дорослих. Йди в реальне життя жити.",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Ні, не хочу більше.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Чому? Тобі ж там добре було.",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Там добре, але грати також закортіло. Хіба я не можу змінити власної думки?",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Можеш, але ми з такими вже не граємо.",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "З якими такими?",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Любителями реальності.",
      "time": "Невертайм"
    },
    {
      "from": "them",
      "type": "text",
      "text": "Ну ок.",
      "time": "Невертайм"
    },
    {
      "from": "me",
      "type": "text",
      "text": "Удачі.",
      "time": "Невертайм"
    }
  ]
}
